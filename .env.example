# 接続許可を得たテスト用Bedrock Dedicated Serverのホスト名またはIPアドレス。
MINECRAFT_HOST=

# Bedrockの標準UDPポート。サーバー側で変更されている場合だけ変更します。
MINECRAFT_PORT=19132

# 通常は空欄にしてサーバー広告から自動判定します。
# 1.26.30.5を明示する場合も、ライブラリ内部では対応プロトコル1.26.30を使用します。
MINECRAFT_VERSION=

# 認証キャッシュを区別するためのローカル識別子。Gamertagやメールアドレスは避けます。
BOT_ACCOUNT_ID=smoke-bot

# 通常運転はnormal固定です。debugは明示的なsmoke観測試験だけで使用します。
BOT_MODE=normal

# 5～300秒。無期限接続を防ぐため、既定値は60秒です。
SMOKE_TIMEOUT_SECONDS=60

# コンテナ内の認証キャッシュ保存先。Compose実行時は通常変更しません。
AUTH_PROFILES_FOLDER=/auth/profiles

# debug、info、warn、errorのいずれか。
LOG_LEVEL=info

# 通常運転の切断後に行う最大再試行回数。初回接続を除き、0～20。
RUNTIME_MAX_RETRIES=3

# 通常運転の初回再接続待機時間（ミリ秒）。100～300000。
RUNTIME_RECONNECT_INITIAL_DELAY_MS=1000

# 指数バックオフの最大待機時間（ミリ秒）。初回待機時間以上、最大300000。
RUNTIME_RECONNECT_MAX_DELAY_MS=30000

# 接続開始からスポーンまでのタイムアウト（ミリ秒）。1000～120000。
RUNTIME_CONNECTION_TIMEOUT_MS=15000

# Discord通知を有効化する場合はtrueにします。falseの場合、DISCORD_WEBHOOK_URLは無視されます。
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=
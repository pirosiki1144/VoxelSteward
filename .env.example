# HTTP health endpoint
HOST=127.0.0.1
PORT=3000

# Local Compose database only. Replace this example password in .env.
POSTGRES_DB=voxel_steward
POSTGRES_USER=voxel_steward
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Future runtime paths must be outside the source tree in deployed environments.
AUTH_CACHE_PATH=/var/lib/voxel-steward/auth
CHECKPOINT_NAMESPACE=default

{
  "name": "voxel-steward",
  "version": "0.1.0",
  "private": true,
  "description": "Safety-first Minecraft Bedrock automation foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "runtime": "node dist/src/runtime.js",
    "scheduled-runtime": "node dist/src/scheduled-runtime.js",
    "smoke": "node dist/src/smoke.js",
    "operator-task": "node dist/src/operator-task.js",
    "operator-log": "node dist/src/operator-log.js",
    "verify:runtime-compose": "node scripts/verify-runtime-compose.mjs",
    "verify:environment-compose": "node scripts/verify-environment-compose.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bedrock-protocol": "https://github.com/PrismarineJS/bedrock-protocol/archive/8da133e7f47493ed8d207ebd59334131d48feb48.tar.gz",
    "minecraft-data": "3.113.0",
    "mysql2": "3.23.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
